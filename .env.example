# ===============================================
# Email Configuration
# ===============================================

# SMTP Server Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Email Account Credentials
# For Gmail: Use your Gmail address and an App Password
# (Not your regular password - generate an App Password in Google Account settings)
EMAIL_USER=admin@lawizer.com
EMAIL_PASS=your-app-password-here

# Sender Email Address (optional, defaults to EMAIL_USER)
EMAIL_FROM=admin@lawizer.com

# ===============================================
# Email Service Options
# ===============================================

# Option 1: Gmail SMTP (Free)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-gmail@gmail.com
# EMAIL_PASS=your-16-character-app-password

# Option 2: SendGrid (Recommended for Production)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=SG.your-sendgrid-api-key

# Option 3: AWS SES
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USER=your-ses-username
# EMAIL_PASS=your-ses-password

# ===============================================
# API Configuration
# ===============================================
# NEXT_PUBLIC_API_URL=https://us-central1-lawizerbe.cloudfunctions.net
NEXT_PUBLIC_API_URL=http://127.0.0.1:5001/lawizerbe/us-central1

# ===============================================
# Supabase Configuration
# ===============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ===============================================
# GraphQL Configuration
# ===============================================
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://olive-dog-534584.hostingersite.com/graphql/
